# 将本文件复制为 oss.env，并填写自己的阿里云 OSS 配置。
# oss.env 已被 .gitignore 排除，严禁提交真实 AccessKey。
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET='填写自己的Bucket名称'
OSS_ACCESS_KEY_ID='填写自己的AccessKey ID'
OSS_ACCESS_KEY_SECRET='填写自己的AccessKey Secret'
OSS_PUBLIC_BASE_URL='https://填写自己的Bucket域名'
OSS_UPLOAD_EXPIRATION_SECONDS=600
